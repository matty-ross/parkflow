{% extends 'vehicles/index.html.twig' %}

{% block title %}Vehicle{% endblock %}

{% block main %}
    <h1>{{ 'title.vehicle'|trans }}</h1>

    <div class="table-responsive">
        <table class="table">
            <tbody>
                <tr>
                    <th>{{ 'label.license_plate'|trans }}</th>
                    <td>{{ vehicle.licensePlate }}</td>
                </tr>
                <tr>
                    <th>{{ 'label.description'|trans }}</th>
                    <td>{{ vehicle.description }}</td>
                </tr>
            </tbody>
        </table>
    </div>

    <a href="{{ path('app_vehicles_edit', {'id': vehicle.id}) }}" class="btn btn-primary"><i class="bi bi-pencil"></i>{{ 'action.edit'|trans }}</a>

    <form method="post" action="{{ path('app_vehicles_delete', {'id': vehicle.id}) }}" class="d-inline">
        <input type="hidden" name="_token" value="{{ csrf_token('app_vehicles_delete' ~ vehicle.id) }}">
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i>{{ 'action.delete'|trans }}</button>
    </form>
{% endblock %}
