{% extends 'vehicles/index.html.twig' %}

{% block main %}
    <h1 class="my-3">{{ 'title.vehicle'|trans }}</h1>

    <div class="table-responsive">
        <table class="table">
            <tbody>
                <tr>
                    <th>{{ 'label.created_at'|trans }}</th>
                    <td>{{ vehicle.createdAt|date('Y-m-d H:i:s') }}</td>
                </tr>
                <tr>
                    <th>{{ 'label.owner'|trans }}</th>
                    <td>
                        <a href="{{ path('app_users_show', {'id': vehicle.owner.id}) }}">{{ vehicle.owner.fullName }}</a>
                    </td>
                </tr>
                <tr>
                    <th>{{ 'label.license_plate'|trans }}</th>
                    <td>{{ vehicle.licensePlate }}</td>
                </tr>
                <tr>
                    <th>{{ 'label.description'|trans }}</th>
                    <td>{{ vehicle.description }}</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a href="{{ path('app_vehicles_edit', {'id': vehicle.id}) }}" class="btn btn-primary"><i class="bi bi-pencil"></i>{{ 'action.edit'|trans }}</a>

        <form method="post" action="{{ path('app_vehicles_delete', {'id': vehicle.id}) }}" data-turbo-confirm="{{ 'question.vehicle_delete'|trans }}">
            <input type="hidden" name="_token" value="{{ csrf_token('app_vehicles_delete' ~ vehicle.id) }}">
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i>{{ 'action.delete'|trans }}</button>
        </form>
    </div>
{% endblock %}
