{% extends 'events/index.html.twig' %}

{% block main %}
    <h1>{{ 'title.event'|trans }}</h1>

    <div class="table-responsive">
        <table class="table">
            <tbody>
                <tr>
                    <th>{{ 'label.created_at'|trans }}</th>
                    <td>{{ event.createdAt|date('Y-m-d H:i:s') }}</td>
                </tr>
                <tr>
                    <th>{{ 'label.action'|trans }}</th>
                    <td>
                        <span class="badge text-bg-secondary">{{ ('label.' ~ event.action|lower)|trans }}</span>
                    </td>
                </tr>
                <tr>
                    <th>{{ 'label.license_plate'|trans }}</th>
                    <td>{{ event.licensePlate }}</td>
                </tr>
                <tr>
                    <th>{{ 'label.recognized_user'|trans }}</th>
                    <td>
                        {% if event.recognizedUser %}
                            <a href="{{ path('app_users_show', {'id': event.recognizedUser.id}) }}">{{ event.recognizedUser }}</a>
                        {% endif %}
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <a href="{{ path('app_events_edit', {'id': event.id}) }}" class="btn btn-primary"><i class="bi bi-pencil"></i>{{ 'action.edit'|trans }}</a>
{% endblock %}
