{{ form_start(form) }}
    {{ form_row(form.email) }}
    {{ form_row(form.password) }}
    {{ form_row(form.fullName) }}
    {{ form_row(form.roles, {'attr': {'class': 'border rounded p-3'}}) }}
    {{ form_row(form.isActive) }}

    <div class="d-flex justify-content-end gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check"></i>{{ 'action.submit'|trans }}</button>
    </div>
{{ form_end(form) }}
