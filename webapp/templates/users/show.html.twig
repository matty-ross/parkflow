{% extends 'users/index.html.twig' %}

{% block main %}
    <h1 class="my-3">{{ 'title.user'|trans }}</h1>

    <div class="table-responsive">
        <table class="table">
            <tbody>
                <tr>
                    <th>{{ 'label.created_at'|trans }}</th>
                    <td>{{ user.createdAt|date('Y-m-d H:i:s') }}</td>
                </tr>
                <tr>
                    <th>{{ 'label.email'|trans }}</th>
                    <td>{{ user.email }}</td>
                </tr>
                <tr>
                    <th>{{ 'label.full_name'|trans }}</th>
                    <td>{{ user.fullName }}</td>
                </tr>
                <tr>
                    <th>{{ 'label.roles'|trans }}</th>
                    <td>{% include '_badges.html.twig' with {'data': user.roles ?? []} %}</td>
                </tr>
                <tr>
                    <th>{{ 'label.is_active'|trans }}</th>
                    <td>
                        {% include '_bool_icon.html.twig' with {'data': user.isActive} %}
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a href="{{ path('app_users_edit', {'id': user.id}) }}" class="btn btn-primary"><i class="bi bi-pencil"></i>{{ 'action.edit'|trans }}</a>

        {% if user.events is empty %}
            <form method="post" action="{{ path('app_users_delete', {'id': user.id}) }}" data-turbo-confirm="{{ 'question.user_delete'|trans }}">
                <input type="hidden" name="_token" value="{{ csrf_token('app_users_delete' ~ user.id) }}">
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i>{{ 'action.delete'|trans }}</button>
            </form>
        {% endif %}
    </div>
{% endblock %}
