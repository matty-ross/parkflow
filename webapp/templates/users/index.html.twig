{% extends 'base.html.twig' %}

{% block title %}{{ parent() ~ ' | ' ~ 'title.users'|trans }}{% endblock %}

{% block main %}
    <div class="d-flex justify-content-between align-items-center my-3">
        <h1>{{ 'title.users'|trans }}</h1>

        <div>
            <a href="{{ path('app_users_create') }}" class="btn btn-primary"><i class="bi bi-plus"></i>{{ 'action.create'|trans }}</a>
        </div>
    </div>

    <div class="table-responsive">
        {{ render_datatable(table, {'class': 'table align-middle'}) }}
    </div>
{% endblock %}
