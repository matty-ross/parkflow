{% extends 'base.html.twig' %}

{% block title %}{{ parent() ~ ' | ' ~ 'title.login'|trans }}{% endblock %}

{% block body %}
    <main class="container">
        {% include '_locale_switcher.html.twig' %}

        <h1>ParkFlow</h1>

        <form method="post">
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <label for="username" class="form-label">{{ 'label.email'|trans }}</label>
            <input id="username" type="email" value="{{ last_username }}" name="_username" class="form-control" required autofocus>

            <label for="password" class="form-label">{{ 'label.password'|trans }}</label>
            <input id="password" type="password" name="_password" class="form-control" required>

            {#
                Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
                See https://symfony.com/doc/current/security/remember_me.html

                <div class="checkbox mb-3">
                    <input type="checkbox" name="_remember_me" id="_remember_me">
                    <label for="_remember_me">Remember me</label>
                </div>
            #}

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" {{ stimulus_controller('csrf-protection') }}>
            <button type="submit" class="btn btn-primary"><i class="bi bi-box-arrow-in-right"></i>{{ 'action.login'|trans }}</button>
        </form>
    </main>
{% endblock %}
