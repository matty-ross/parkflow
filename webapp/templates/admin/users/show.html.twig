{% extends 'admin/users/index.html.twig' %}

{% block main %}
    <h1>{{ 'title.user'|trans }}</h1>

    <div class="table-responsive">
        <table class="table">
            <tbody>
                <tr>
                    <th>{{ 'label.created_at'|trans }}</th>
                    <td>{{ user.createdAt|date('Y-m-d H:i:s') }}</td>
                </tr>
                <tr>
                    <th>{{ 'label.email'|trans }}</th>
                    <td>{{ user.email }}</td>
                </tr>
                <tr>
                    <th>{{ 'label.first_name'|trans }}</th>
                    <td>{{ user.firstName }}</td>
                </tr>
                <tr>
                    <th>{{ 'label.last_name'|trans }}</th>
                    <td>{{ user.lastName }}</td>
                </tr>
                <tr>
                    <th>{{ 'label.roles'|trans }}</th>
                    <td>
                        {% for role in user.roles ?? [] %}
                            <span class="badge text-bg-secondary">{{ role }}</span>
                        {% endfor %}
                    </td>
                </tr>
                <tr>
                    <th>{{ 'label.is_active'|trans }}</th>
                    <td>{{ user.isActive ? 'Yes' : 'No' }}</td>
                </tr>
            </tbody>
        </table>
    </div>

    <a href="{{ path('app_admin_users_edit', {'id': user.id}) }}" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>{{ 'action.edit'|trans }}</a>

    <form method="post" action="{{ path('app_admin_users_delete', {'id': user.id}) }}" class="d-inline">
        <input type="hidden" name="_token" value="{{ csrf_token('app_admin_users_delete' ~ user.id) }}">
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>{{ 'action.delete'|trans }}</button>
    </form>
{% endblock %}
