{% extends 'admin/users/index.html.twig' %}

{% block main %}
    <h1>User</h1>

    <div class="table-responsive">
        <table class="table">
            <tbody>
                <tr>
                    <th>{{ 'label.created_at'|trans }}</th>
                    <td>{{ user.createdAt|date('Y-m-d H:i:s T') }}</td>
                </tr>
                <tr>
                    <th>{{ 'label.email'|trans }}</th>
                    <td>{{ user.email }}</td>
                </tr>
                <tr>
                    <th>{{ 'label.first_name'|trans }}</th>
                    <td>{{ user.firstName }}</td>
                </tr>
                <tr>
                    <th>{{ 'label.last_name'|trans }}</th>
                    <td>{{ user.lastName }}</td>
                </tr>
                <tr>
                    <th>{{ 'label.roles'|trans }}</th>
                    <td>{{ user.roles ? user.roles|json_encode : '' }}</td>
                </tr>
                <tr>
                    <th>{{ 'label.is_active'|trans }}</th>
                    <td>{{ user.isActive ? 'Yes' : 'No' }}</td>
                </tr>
            </tbody>
        </table>
    </div>

    <a href="{{ path('app_admin_users_edit', {'id': user.id}) }}" class="btn btn-primary">edit</a>

    {{ include('admin/users/_delete_form.html.twig') }}
{% endblock %}
