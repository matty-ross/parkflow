{% extends 'admin.html.twig' %}

{% block title %}{{ parent() ~ ' | ' ~ 'title.users'|trans }}{% endblock %}

{% block main %}
    <h1>{{ 'title.users'|trans }}</h1>

    <a href="{{ path('app_admin_users_new') }}" class="btn btn-primary">{{ 'action.new'|trans }}</a>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ 'label.email'|trans }}</th>
                    <th>{{ 'label.full_name'|trans }}</th>
                    <th>{{ 'label.roles'|trans }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr {% if not user.isActive %}class="table-danger"{% endif %}>
                    <td>{{ user.email }}</td>
                    <td>{{ user.firstName ~ ' ' ~ user.lastName }}</td>
                    <td>
                        {% for role in user.roles ?? [] %}
                            <span class="badge text-bg-secondary">{{ role }}</span>
                        {% endfor %}
                    </td>
                    <td>
                        <a href="{{ path('app_admin_users_show', {'id': user.id}) }}" class="btn btn-sm btn-outline-primary">{{ 'action.show'|trans }}</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center">{{ 'result.no_results'|trans }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
