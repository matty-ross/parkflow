{% extends 'admin.html.twig' %}

{% block title %}{{ parent() ~ ' | ' ~ 'title.vehicles'|trans }}{% endblock %}

{% block main %}
    <h1>{{ 'title.vehicles'|trans }}</h1>

    <a href="{{ path('app_admin_vehicles_create') }}" class="btn btn-primary"><i class="bi bi-plus me-1"></i>{{ 'action.create'|trans }}</a>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ 'label.owner'|trans }}</th>
                    <th>{{ 'label.license_plate'|trans }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            {% for vehicle in vehicles %}
                <tr>
                    <td>
                        <a href="{{ path('app_admin_users_show', {'id': vehicle.owner.id}) }}">{{ vehicle.owner }}</a>
                    </td>
                    <td>{{ vehicle.licensePlate }}</td>
                    <td>
                        <a href="{{ path('app_admin_vehicles_show', {'id': vehicle.id}) }}" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye me-1"></i>{{ 'action.show'|trans }}</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3" class="text-center">{{ 'result.no_results'|trans }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
