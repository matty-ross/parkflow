<div class="bg-body-tertiary">
    <nav class="navbar navbar-expand container" {{ stimulus_controller('navbar', controller_classes: {'active': 'active'}) }}>
        <a href="{{ path('app_admin_home_index') }}" class="navbar-brand">ParkFlow</a>

        <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbar-content">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div id="navbar-content" class="navbar-collapse collapse">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a href="{{ path('app_admin_users_index') }}" class="nav-link" {{ stimulus_target('navbar', 'navLink') }}><i class="bi bi-person"></i>{{ 'title.users'|trans }}</a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('app_admin_vehicles_index') }}" class="nav-link" {{ stimulus_target('navbar', 'navLink') }}><i class="bi bi-car-front"></i>{{ 'title.vehicles'|trans }}</a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('app_admin_records_index') }}" class="nav-link" {{ stimulus_target('navbar', 'navLink') }}><i class="bi bi-p-square"></i>{{ 'title.records'|trans }}</a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('app_admin_payments_index') }}" class="nav-link" {{ stimulus_target('navbar', 'navLink') }}><i class="bi bi-credit-card"></i>{{ 'title.payments'|trans }}</a>
                </li>
            </ul>
        </div>

        <div class="dropdown">
            <button type="button" class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                <i class="bi bi-person-circle"></i>
            </button>
            <ul class="dropdown-menu">
                <li>
                    <div class="dropdown-item-text">{{ app.user.email }}</div>
                </li>
                <li>
                    <a href="{{ logout_path() }}" class="dropdown-item text-danger" data-turbo="false"><i class="bi bi-box-arrow-left"></i>{{ 'action.logout'|trans }}</a>
                </li>
            </ul>
        </div>

        {% include '_locale_switcher.html.twig' %}
    </nav>
