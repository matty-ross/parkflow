{% extends 'admin.html.twig' %}

{% block title %}{{ parent() ~ ' | ' ~ 'title.records'|trans }}{% endblock %}

{% block main %}
    <h1>{{ 'title.records'|trans }}</h1>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ 'label.license_plate'|trans }}</th>
                    <th>{{ 'label.recognized_user'|trans }}</th>
                    <th>{{ 'label.entered_at'|trans }}</th>
                    <th>{{ 'label.exited_at'|trans }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            {% for record in records %}
                <tr>
                    <td>{{ record.licensePlate }}</td>
                    <td>
                        {% if record.recognizedUser %}
                            <a href="{{ path('app_admin_users_show', {'id': record.recognizedUser.id}) }}">{{ record.recognizedUser }}</a>
                        {% endif %}
                    </td>
                    <td>{{ record.enteredAt|date('Y-m-d H:i:s') }}</td>
                    <td>{{ record.exitedAt ? record.exitedAt|date('Y-m-d H:i:s') : null }}</td>
                    <td>
                        <a href="{{ path('app_admin_records_show', {'id': record.id}) }}" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye me-1"></i>{{ 'action.show'|trans }}</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center">{{ 'result.no_results'|trans }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
