{% extends 'base.html.twig' %}

{% block title %}{{ parent() ~ ' | ' ~ 'title.profile'|trans }}{% endblock %}

{% block main %}
    <h1>{{ 'title.profile'|trans }}</h1>

    <div class="table-responsive">
        <table class="table">
            <tbody>
                <tr>
                    <th>{{ 'label.email'|trans }}</th>
                    <td>{{ user.email }}</td>
                </tr>
                <tr>
                    <th>{{ 'label.first_name'|trans }}</th>
                    <td>{{ user.firstName }}</td>
                </tr>
                <tr>
                    <th>{{ 'label.last_name'|trans }}</th>
                    <td>{{ user.lastName }}</td>
                </tr>
            </tbody>
        </table>
    </div>

    <a href="{{ path('app_profile_edit') }}" class="btn btn-primary"><i class="bi bi-pencil"></i>{{ 'action.edit'|trans }}</a>
{% endblock %}
